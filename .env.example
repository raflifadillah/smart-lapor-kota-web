# =============================================================================
# Smart Lapor Kota — Environment Variables Template
# Salin file ini menjadi .env dan sesuaikan nilainya.
# File .env TIDAK boleh di-commit ke Git (sudah ada di .gitignore).
#
# Untuk deployment produksi (VPS / Docker / Render / Railway):
#   Masukkan setiap variabel di bawah ke dalam panel Environment Variables
#   di platform hosting Anda — JANGAN upload file .env ke server secara manual.
# =============================================================================

# --- DATABASE (PostgreSQL 16 + PostGIS 3.4) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Lokal    : postgres://postgres:postgres@localhost:5432/smart_lapor_db
# Docker   : postgres://postgres:postgrespassword@db:5432/smart_lapor_db
# Produksi : Gunakan connection string dari provider DB Anda (Supabase, Neon, dll.)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_lapor_db

# --- SERVER ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- JWT AUTHENTICATION ---
# WAJIB diganti dengan nilai acak panjang di produksi. Gunakan:
#   openssl rand -hex 64
JWT_SECRET=GANTI_DENGAN_STRING_RAHASIA_ACAK_MINIMAL_64_KARAKTER_DI_PRODUKSI

# --- APLIKASI ---
# development | production
APP_ENV=development

# Level log Rust (production: gunakan 'info' atau 'warn' saja)
RUST_LOG=info,smart_lapor_kota=debug

# Direktori penyimpanan foto unggahan
UPLOAD_DIR=./static/uploads

# --- CORS (opsional, untuk produksi dengan domain terpisah) ---
# Daftar origin yang diizinkan, pisahkan dengan koma
# Contoh: https://smartlaporkota.go.id,https://admin.smartlaporkota.go.id
ALLOWED_ORIGINS=*
